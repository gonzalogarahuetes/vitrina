# Local development values. No production counterpart — the same class as the
# object-store credentials in s3-config.json. Copy to .env.
#
#   node --env-file=.env packages/server/dist/index.js

CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://admin:password@localhost:5432/vitrina

# The local SeaweedFS from docker-compose.yml. The credentials are the ones
# s3-config.json and the compose file already commit; a deployment has its own.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=vitrina-media
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=10881ccdfa15dda85b360cf10d216988
AWS_SECRET_ACCESS_KEY=ba68c34138d377ae4522f13c55675c9c

# The one server secret: base64url, at least 32 bytes, validated at boot.
# Domain-separated into the pepper over owners.auth_hash and the deterministic
# decoy salts that make an unknown address indistinguishable from a real one.
#
# THIS VALUE IS PUBLIC AND FOR LOCAL USE ONLY. A deployment generates its own
# 32 bytes from a CSPRNG and backs them up as reliably as the database and NOT
# in the same artifact — one snapshot holding both collapses the pepper to an
# unpeppered hash. It is effectively permanent: rotating it moves every decoy
# salt while real salts stay put, which tells anyone comparing across the
# rotation which addresses exist.
#
#   head -c 32 /dev/urandom | basenc --base64url | tr -d '='
VITRINA_SERVER_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtc2VjcmV0LW5vdC1mb3ItdXNl

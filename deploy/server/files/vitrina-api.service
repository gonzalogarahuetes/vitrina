# /etc/systemd/system/vitrina-api.service — installed by provision.sh.
#
# The relay, as its own unprivileged user, read-only everywhere, behind Caddy.
# Skipped cleanly (not failed, not restarted in a loop) until phase 5 has put
# a release in place and phase 4 its environment.

[Unit]
Description=Vitrina relay API
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
ConditionPathExists=/opt/vitrina/api/current/dist/index.js
ConditionPathExists=/etc/vitrina/api.env
# A boot failure (missing secret, wrong bucket) is configuration, not a blip:
# five tries in two minutes, then it stays down and says so.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=vitrina
Group=vitrina
WorkingDirectory=/opt/vitrina/api/current
ExecStart=/usr/local/bin/node /opt/vitrina/api/current/dist/index.js

# Loopback only, in the unit rather than the env file, so no edit of that
# file can expose the API past Caddy. config.ts defaults to 0.0.0.0.
Environment=HOST=127.0.0.1 PORT=3000 NODE_ENV=production
# Read by systemd (root) and passed in; the service never reads the files.
# The secret and the rest of the configuration (phase 4):
EnvironmentFile=/etc/vitrina/api.env
# The signup allowlist, on its own so adding a family member never means
# opening the secret's file. Optional here: absent means closed, in the server.
EnvironmentFile=-/etc/vitrina/signup.env

Restart=on-failure
RestartSec=5

# --- hardening ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# NOT MemoryDenyWriteExecute: V8's JIT needs writable-executable memory, and
# setting it kills node at startup.

[Install]
WantedBy=multi-user.target

# Names only. Copy OUTSIDE the repository (acceptance.mjs refuses a file inside it):
#   mkdir -p ~/.vitrina && chmod 700 ~/.vitrina
#   cp deploy/storage/storage.env.example ~/.vitrina/storage.env && chmod 600 ~/.vitrina/storage.env
# Same names packages/server/src/config.ts reads, so the values tested are the values deployed.
# Endpoint and region are the bucket's location as the Hetzner console shows them.
S3_ENDPOINT=
S3_BUCKET=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Names only. For recover.sh, on the Mac, during a recovery or its rehearsal:
#   cp deploy/backup/backup-bucket.env.example ~/.vitrina/backup-bucket.env && chmod 600 ~/.vitrina/backup-bucket.env
# Values from the password manager's backup-bucket entry. recover.sh only lists
# and reads this bucket. Delete the file when the recovery is done.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
